# Full Connection String for Backend
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/research_db

# Qdrant URL configuration
QDRANT_URL=http://localhost:6333

# App Settings
SECRET_KEY=dev-secret-key
UPLOAD_DIR=./uploads

# Gemini configuration (Replace with actual key)
GEMINI_API_KEY=your-gemini-api-key-here

# Raw DB credentials (used by the postgres image initialization)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=research_db
